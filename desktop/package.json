{
  "name": "multiview-desktop",
  "productName": "투네이션 후원 브라우저",
  "version": "0.1.35",
  "description": "유튜브·트위치 방송을 여러 개 동시에 보며 투네이션으로 후원하는 설치형 멀티뷰",
  "main": "main.js",
  "author": "Toonation",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build:web": "npm run build --prefix .. -- --outDir desktop/web --emptyOutDir",
    "start": "npm run build:web && electron .",
    "dev": "electron . --dev",
    "test": "node --test test/staticServer.test.js test/handlers.test.js test/donateController.test.js test/prefs.test.js test/donateFill.test.js test/windowBounds.test.js test/webviewPolicy.test.js test/appOptions.test.js test/webStore.test.js test/mobileDonate.test.js test/appIdentity.test.js test/signatures.test.js test/donateSignature.test.js",
    "dist": "npm run build:web && node scripts/dist.js"
  },
  "build": {
    "appId": "at.toon.donator.multiview",
    "productName": "투네이션 후원 브라우저",
    "artifactName": "MultiviewDonate-Setup-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "pip.html",
      "pip-preload.js",
      "lib/**/*",
      "assets/**/*",
      "web/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "투네이션 후원 브라우저",
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
